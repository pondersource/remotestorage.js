 .../lws/server/http/LwsResourceServlet.java   |  29 +-
 .../server/http/BinaryReadLifetimeTest.java   | 274 ++++++++++++++++++
 3 files changed, 402 insertions(+), 15 deletions(-)
 create mode 100644 src/test/java/com/ebremer/lws/server/http/BinaryReadLifetimeTest.java

