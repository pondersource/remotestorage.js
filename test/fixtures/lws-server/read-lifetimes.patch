+    private ReadResult readMetadata(String iri, LwsPrincipal principal) {
+        return rdf.read(conn -> {
             LwsResource meta = registry.find(conn, iri)
                     .orElseThrow(() -> absent(principal, iri, AclMode.READ));
             authorize(principal, iri, AclMode.READ);
@@ -219,6 +228,9 @@ public final class ResourceService {
                 }
             }
         });
+    }
+
+    private ReadResult visibleRead(ReadResult loaded, LwsPrincipal principal) {
         // The container's entity-tag is the one persisted in the registry (refreshed by `touch`
         // whenever its membership changes), NOT a hash of this rendering. A content-derived tag
         // here could never match the value If-Match is evaluated against, which made conditional
@@ -291,7 +303,101 @@ public final class ResourceService {
         return container.withModified(now).withEtag(Etags.of(container.iri(), now.toString()));
     }
 
-    /** Open the bytes of a non-RDF resource. Caller closes the stream. */
+    /**
+     * A response snapshot whose immutable binary key stays reachable until close.
+     * The body opens lazily, so HEAD, 304 and rejected preconditions open no file.
+     * Always use a try-with-resources scope, including when response writing fails.
+     */
+    public final class ReadHandle implements AutoCloseable {
+        private final ReadResult result;
+        private final String binaryKey;
+        private InputStream stream;
+        private boolean closed;
+
+        private ReadHandle(ReadResult result, String binaryKey) {
+            this.result = result;
+            this.binaryKey = binaryKey;
+        }
+
+        public ReadResult result() { return result; }
+
+        public InputStream binary() throws IOException {
+            if (closed || binaryKey == null) {
+                throw new IOException("No open binary response snapshot");
+            }
+            if (stream == null) { stream = blobs.read(binaryKey); }
+            return stream;
+        }
+
+        @Override
+        public void close() throws IOException {
+            if (closed) { return; }
+            closed = true;
+            try {
+                if (stream != null) { stream.close(); }
+            } finally {
+                if (binaryKey != null) { releaseBlob(binaryKey); }
+            }
+        }
+    }
+
+    /**
+     * Load HTTP metadata and pin its binary version before a writer can retire it.
+     * An older ambient transaction could name an already-retired key, so response
+     * snapshots must begin here, outside a caller-owned metadata transaction.
+     * Authorization preparation and subsequent blob I/O stay outside the guard.
+     */
+    public ReadHandle openRead(String path, LwsPrincipal principal, boolean withBody) {
+        if (rdf.inUnitOfWork()) {
+            throw new IllegalStateException("Response snapshots must start outside a metadata transaction");
+        }
+        String iri = pathToIri(path);
+        prepare(principal, iri, AclMode.READ);
+        ReadResult loaded;
+        String key = null;
+        synchronized (blobLifetime) {
+            loaded = readMetadata(iri, principal);
+            if (withBody && !loaded.isRdf() && !loaded.isContainer()) {
+                key = loaded.meta().binaryKey();
+                if (key != null) { blobReaders.merge(key, 1, Integer::sum); }
+            }
+        }
+        // Only container visibility can do more authorization work, and a
+        // container has no binary pin to leak if that preparation fails.
+        return new ReadHandle(visibleRead(loaded, principal), key);
+    }
+
+    private void releaseBlob(String key) {
+        boolean discard = false;
+        synchronized (blobLifetime) {
+            int count = blobReaders.get(key);
+            if (count == 1) {
+                blobReaders.remove(key);
+                discard = retiredBlobs.remove(key);
+            } else {
+                blobReaders.put(key, count - 1);
+            }
+        }
+        if (discard) { discardBlobs(List.of(key), "superseded"); }
+    }
+
+    /** Defer only versions actually pinned by responses; other obsolete keys go now. */
+    private void retireBlobs(List<String> keys) {
+        List<String> discard = new ArrayList<>();
+        synchronized (blobLifetime) {
+            for (String key : keys) {
+                if (blobReaders.containsKey(key)) { retiredBlobs.add(key); }
+                else { discard.add(key); }
+            }
+        }
+        discardBlobs(discard, "superseded");
+    }
+
+    /**
+     * Open bytes for an existing metadata object; caller closes the stream.
+     * This does not pin an earlier metadata snapshot. HTTP responses must use
+     * {@link #openRead} so a concurrent replacement cannot retire their version.
+     */
     public InputStream openBinary(LwsResource meta) throws IOException {
         return blobs.read(meta.binaryKey());
     }
@@ -322,7 +428,7 @@ public final class ResourceService {
             discardBlobs(changes.staged, "uncommitted");
             throw e;
         }
-        discardBlobs(changes.obsolete, "superseded");
+        retireBlobs(changes.obsolete);
         return result;
     }
 
@@ -1423,7 +1529,7 @@ public final class ResourceService {
                 existing.map(LwsResource::binaryKey).filter(java.util.Objects::nonNull)
                         .ifPresent(blobChanges.obsolete::add);
                 String ct = req.contentType() == null ? "application/octet-stream"
-                        : RdfFormats.stripParameters(req.contentType());
+                        : req.contentType();
                 return new LwsResource(iri, ResourceType.NON_RDF_SOURCE, parentIri, created, modified,
                         staged.sha256Hex().substring(0, 16), ct, staged.size(), staged.key(), owner,
                         staged.sha256Hex());
