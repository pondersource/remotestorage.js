     private final Clock clock;
+    // Snapshot creation and pinning share this guard with post-commit retirement.
+    // Never acquire it from a metadata write callback; no blob I/O runs under it.
+    private final Object blobLifetime = new Object();
+    private final Map<String, Integer> blobReaders = new LinkedHashMap<>();
+    private final Set<String> retiredBlobs = new LinkedHashSet<>();
     private final List<ResourceEventListener> listeners = new CopyOnWriteArrayList<>();
     private final List<ResourceCleanup> cleanups = new CopyOnWriteArrayList<>();
     private final List<ResourceRelocation> relocations = new CopyOnWriteArrayList<>();
