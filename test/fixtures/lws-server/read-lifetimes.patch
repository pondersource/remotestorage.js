diff --git a/src/test/java/com/ebremer/lws/server/http/BinaryReadLifetimeTest.java b/src/test/java/com/ebremer/lws/server/http/BinaryReadLifetimeTest.java
new file mode 100644
index 0000000..efb90c3
--- /dev/null
+++ b/src/test/java/com/ebremer/lws/server/http/BinaryReadLifetimeTest.java
@@ -0,0 +1,274 @@
+package com.ebremer.lws.server.http;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.util.Properties;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Semaphore;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import jakarta.servlet.ServletOutputStream;
+import jakarta.servlet.WriteListener;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.apache.jena.query.DatasetFactory;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import com.ebremer.lws.server.LwsConfiguration;
+import com.ebremer.lws.server.core.IfMatch;
+import com.ebremer.lws.server.core.LwsPrincipal;
+import com.ebremer.lws.server.core.LwsResource;
+import com.ebremer.lws.server.core.ResourceRegistry;
+import com.ebremer.lws.server.core.ResourceService;
+import com.ebremer.lws.server.rdf.Tdb2RdfStore;
+import com.ebremer.lws.server.storage.BinaryStore;
+import com.ebremer.lws.server.storage.FileSystemBinaryStore;
+
+/** Real servlet/metadata/blob paths, with deterministic pauses before filesystem open. */
+class BinaryReadLifetimeTest {
+    private static final String TYPE = "application/json; charset=UTF-8";
+    private static final String OLD = "{ \"title\": \"old\" }\n";
+    private static final String NEW = "{ \"title\": \"new\" }\n";
+    private static final LwsPrincipal OWNER = new LwsPrincipal("https://owner.example/#me", null, null);
+    private ResourceService service;
+    private Tdb2RdfStore store;
+    private LwsResourceServlet servlet;
+    private BlockingBlobs blobs;
+
+    @BeforeEach
+    void setup(@TempDir Path directory) {
+        Properties p = new Properties();
+        p.setProperty("lws.base-uri", "http://example.org");
+        p.setProperty("lws.owners", OWNER.webId());
+        p.setProperty("lws.data-dir", directory.toString());
+        LwsConfiguration config = LwsConfiguration.of(p);
+        blobs = new BlockingBlobs(new FileSystemBinaryStore(config.blobDir()));
+        store = new Tdb2RdfStore(DatasetFactory.createTxnMem());
+        service = new ResourceService(store, blobs,
+                new ResourceRegistry(), (principal, iri, mode) -> true, config, Clock.systemUTC());
+        service.ensureStorageRoot();
+        servlet = new LwsResourceServlet(service, config, null, null);
+    }
+
+    private ResourceService.WriteRequest json(String value) {
+        return new ResourceService.WriteRequest(TYPE, value.getBytes(StandardCharsets.UTF_8), null, null);
+    }
+
+    private LwsResource original() {
+        service.put("/doc.json", OWNER, json(OLD));
+        return service.stat("/doc.json").orElseThrow();
+    }
+
+    private HttpServletRequest request(String method) {
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getMethod()).thenReturn(method);
+        when(request.getRequestURI()).thenReturn("/doc.json");
+        when(request.getContextPath()).thenReturn("");
+        return request;
+    }
+
+    private HttpServletResponse response(ByteArrayOutputStream body, Runnable beforeWrite) throws IOException {
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        when(response.getOutputStream()).thenReturn(new ServletOutputStream() {
+            @Override public void write(int b) throws IOException {
+                if (beforeWrite != null) { beforeWrite.run(); throw new IOException("Client disconnected"); }
+                body.write(b);
+            }
+            @Override public boolean isReady() { return true; }
+            @Override public void setWriteListener(WriteListener listener) {}
+        });
+        return response;
+    }
+
+    private CompletableFuture<String> get(java.util.concurrent.Executor executor) {
+        String etag = service.stat("/doc.json").orElseThrow().quotedEtag();
+        return CompletableFuture.supplyAsync(() -> {
+            ByteArrayOutputStream body = new ByteArrayOutputStream();
+            try {
+                HttpServletResponse response = response(body, null);
+                servlet.service(request("GET"), response);
+                verify(response).setHeader("ETag", etag);
+            } catch (IOException e) { throw new java.io.UncheckedIOException(e); }
+            return body.toString(StandardCharsets.UTF_8);
+        }, executor);
+    }
+
+    @Test
+    void replacementKeepsTheSnapshotBlobUntilItsLastReaderCloses() throws Exception {
+        LwsResource old = original();
+        blobs.pause(2);
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            var first = get(executor);
+            var second = get(executor);
+            try {
+                assertTrue(blobs.entered.await(10, TimeUnit.SECONDS), "both GETs must reach blob open");
+                service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+                // The writer has already returned: streaming readers must not hold the writer lock.
+                blobs.release.release();
+                assertEquals(OLD, CompletableFuture.anyOf(first, second).get(10, TimeUnit.SECONDS));
+                assertTrue(blobs.exists(old.binaryKey()), "the other reader still needs the old blob");
+            } finally { blobs.release.release(2); }
+            assertEquals(OLD, first.get(10, TimeUnit.SECONDS));
+            assertEquals(OLD, second.get(10, TimeUnit.SECONDS));
+        }
+        assertFalse(blobs.exists(old.binaryKey()), "last reader must promptly reclaim the retired blob");
+        assertTrue(blobs.exists(service.stat("/doc.json").orElseThrow().binaryKey()));
+    }
+
+    @Test
+    void deletionCannotRetireAResponseSnapshotBeforeTheFileIsOpened() throws Exception {
+        LwsResource old = original();
+        blobs.pause(1);
+        try (var executor = Executors.newSingleThreadExecutor()) {
+            var pending = get(executor);
+            try {
+                assertTrue(blobs.entered.await(10, TimeUnit.SECONDS));
+                service.delete("/doc.json", OWNER);
+            } finally { blobs.release.release(); }
+            assertEquals(OLD, pending.get(10, TimeUnit.SECONDS));
+        }
+        assertTrue(service.stat("/doc.json").isEmpty());
+        assertFalse(blobs.exists(old.binaryKey()));
+    }
+
+    @Test
+    void notModifiedClosesTheSnapshotWithoutOpeningItsBody() throws Exception {
+        LwsResource old = original();
+        HttpServletRequest request = request("GET");
+        when(request.getHeader("If-None-Match")).thenReturn('"' + old.etag() + '"');
+        HttpServletResponse response = response(new ByteArrayOutputStream(), null);
+        doAnswer(call -> {
+            service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+            assertTrue(blobs.exists(old.binaryKey()), "snapshot remains pinned until response exit");
+            return null;
+        }).when(response).setStatus(304);
+        servlet.service(request, response);
+        verify(response).setStatus(304);
+        assertEquals(0, blobs.reads.get());
+        assertFalse(blobs.exists(old.binaryKey()));
+    }
+
+    @Test
+    void anOutputFailureStillReleasesTheRetiredBlob() throws Exception {
+        LwsResource old = original();
+        HttpServletResponse response = response(new ByteArrayOutputStream(), () -> {
+            service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+            assertTrue(blobs.exists(old.binaryKey()));
+        });
+        assertThrows(IOException.class, () -> servlet.service(request("GET"), response));
+        assertFalse(blobs.exists(old.binaryKey()));
+    }
+
+    @Test
+    void anOpenFailureStillReleasesTheRetiredBlob() throws Exception {
+        LwsResource old = original();
+        blobs.beforeFailure = () -> {
+            service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+            assertTrue(blobs.exists(old.binaryKey()));
+        };
+        assertThrows(IOException.class, () -> servlet.service(request("GET"), response(new ByteArrayOutputStream(), null)));
+        assertFalse(blobs.exists(old.binaryKey()));
+    }
+
+    @Test
+    void aSlowReaderDoesNotRetainUnrelatedObsoleteVersions() throws Exception {
+        LwsResource old = original();
+        service.put("/other.json", OWNER, json(OLD));
+        LwsResource other = service.stat("/other.json").orElseThrow();
+        blobs.pause(1);
+        try (var executor = Executors.newSingleThreadExecutor()) {
+            var pending = get(executor);
+            try {
+                assertTrue(blobs.entered.await(10, TimeUnit.SECONDS));
+                service.put("/other.json", OWNER, json(NEW), IfMatch.of(other.etag()));
+                assertFalse(blobs.exists(other.binaryKey()), "only the actual response key is retained");
+                service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+                assertTrue(blobs.exists(old.binaryKey()));
+            } finally { blobs.release.release(); }
+            assertEquals(OLD, pending.get(10, TimeUnit.SECONDS));
+        }
+        assertFalse(blobs.exists(old.binaryKey()));
+    }
+
+    @Test
+    void responseSnapshotsCannotReuseAnOlderAmbientMetadataTransaction() {
+        LwsResource old = original();
+        store.read(conn -> {
+            assertThrows(IllegalStateException.class, () -> service.openRead("/doc.json", OWNER, true));
+            return null;
+        });
+        service.put("/doc.json", OWNER, json(NEW), IfMatch.of(old.etag()));
+        assertFalse(blobs.exists(old.binaryKey()), "a refused response snapshot must not pin a blob");
+    }
+
+    @Test
+    void nonRdfHttpHeaderPreservesMediaParameters() throws Exception {
+        original();
+        var context = new org.eclipse.jetty.ee10.servlet.ServletContextHandler();
+        context.setContextPath("/");
+        context.addServlet(new org.eclipse.jetty.ee10.servlet.ServletHolder(servlet), "/*");
+        var server = new org.eclipse.jetty.server.Server(new java.net.InetSocketAddress("127.0.0.1", 0));
+        server.setHandler(context);
+        server.start();
+        try (var client = java.net.http.HttpClient.newHttpClient()) {
+            int port = ((org.eclipse.jetty.server.ServerConnector) server.getConnectors()[0]).getLocalPort();
+            var request = java.net.http.HttpRequest.newBuilder(java.net.URI.create("http://127.0.0.1:" + port + "/doc.json")).build();
+            var response = client.send(request, java.net.http.HttpResponse.BodyHandlers.ofString());
+            assertEquals(200, response.statusCode());
+            String mediaType = response.headers().firstValue("Content-Type").orElseThrow();
+            // Servlet containers can normalize optional whitespace and charset
+            // case; the actual parameter must survive, along with the bytes.
+            assertTrue(mediaType.matches("(?i)application/json;\\s*charset=utf-8"), mediaType);
+            assertEquals(OLD, response.body());
+        } finally { server.stop(); }
+    }
+
+    @Test
+    void nonRdfContentTypeParametersRoundTripWithoutChangingTheBytes() throws Exception {
+        LwsResource old = original();
+        assertEquals(TYPE, old.contentType());
+        ByteArrayOutputStream body = new ByteArrayOutputStream();
+        HttpServletResponse response = response(body, null);
+        servlet.service(request("GET"), response);
+        verify(response).setContentType(TYPE);
+        assertEquals(OLD, body.toString(StandardCharsets.UTF_8));
+        int reads = blobs.reads.get();
+        servlet.service(request("HEAD"), response(new ByteArrayOutputStream(), null));
+        assertEquals(reads, blobs.reads.get(), "HEAD must not open the body");
+    }
+
+    private static final class BlockingBlobs implements BinaryStore {
+        private final BinaryStore delegate;
+        private final AtomicInteger reads = new AtomicInteger();
+        private volatile CountDownLatch entered;
+        private volatile Semaphore release;
+        private volatile Runnable beforeFailure;
+        BlockingBlobs(BinaryStore delegate) { this.delegate = delegate; }
+        void pause(int readers) { entered = new CountDownLatch(readers); release = new Semaphore(0); }
+        @Override public InputStream read(String key) throws IOException {
+            reads.incrementAndGet();
+            if (entered != null) {
+                entered.countDown();
+                try {
+                    if (!release.tryAcquire(10, TimeUnit.SECONDS)) { throw new IOException("Reader barrier timed out"); }
+                } catch (InterruptedException e) { Thread.currentThread().interrupt(); throw new IOException(e); }
+            }
+            if (beforeFailure != null) { beforeFailure.run(); throw new IOException("Injected open failure"); }
+            return delegate.read(key);
+        }
+        @Override public StoredBlob write(String key, InputStream data) throws IOException { return delegate.write(key, data); }
+        @Override public void delete(String key) throws IOException { delegate.delete(key); }
+        @Override public long size(String key) throws IOException { return delegate.size(key); }
+        @Override public boolean exists(String key) { return delegate.exists(key); }
+    }
+}

