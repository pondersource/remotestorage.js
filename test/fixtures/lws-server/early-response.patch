--- /dev/null
+++ b/src/test/java/com/ebremer/lws/server/http/UnreadBodyConnectionFilterTest.java
@@ -0,0 +1,90 @@
+package com.ebremer.lws.server.http;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import jakarta.servlet.ServletInputStream;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.junit.jupiter.api.Test;
+
+class UnreadBodyConnectionFilterTest {
+    private final UnreadBodyConnectionFilter filter = new UnreadBodyConnectionFilter();
+
+    @Test
+    void doesNotSendAnHttp1ConnectionHeaderOnHttp2() throws Exception {
+        HttpServletRequest request = request("HTTP/2.0", 4096);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        filter.doFilter(request, response, (req, res) -> res.flushBuffer());
+        verify(response, never()).setHeader(eq("Connection"), anyString());
+        verify(request, never()).getInputStream();
+    }
+
+    @Test
+    void aBodylessHttp1ResponseKeepsItsExistingConnectionPolicy() throws Exception {
+        HttpServletRequest request = request("HTTP/1.1", 0);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        filter.doFilter(request, response, (req, res) -> res.flushBuffer());
+        verify(response, never()).setHeader(eq("Connection"), anyString());
+        verify(request, never()).getInputStream();
+    }
+
+    @Test
+    void anUnreadChunkedBodyIsClosedBeforeWriterOutput() throws Exception {
+        HttpServletRequest request = request("HTTP/1.1", -1);
+        when(request.getHeader("Transfer-Encoding")).thenReturn("chunked");
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        when(response.getWriter()).thenReturn(new PrintWriter(new StringWriter()));
+        filter.doFilter(request, response, (req, res) -> res.getWriter().write("refused"));
+        verify(response, org.mockito.Mockito.atLeastOnce()).setHeader("Connection", "close");
+    }
+
+    @Test
+    void anEmptyEarlyResponseAlsoAnnouncesClose() throws Exception {
+        HttpServletRequest request = request("HTTP/1.0", 4096);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        filter.doFilter(request, response, (req, res) -> ((HttpServletResponse) res).setStatus(401));
+        verify(response).setHeader("Connection", "close");
+    }
+
+    @Test
+    void anExceptionBeforeOutputStillAnnouncesCloseAndKeepsItsCause() throws Exception {
+        HttpServletRequest request = request("HTTP/1.1", 4096);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        IOException original = new IOException("handler failed");
+        IOException caught = assertThrows(IOException.class,
+                () -> filter.doFilter(request, response, (req, res) -> { throw original; }));
+        assertSame(original, caught);
+        verify(response).setHeader("Connection", "close");
+    }
+
+    @Test
+    void aGuardFailureDoesNotReplaceTheOriginalHandlerFailure() throws Exception {
+        HttpServletRequest request = request("HTTP/1.1", 4096);
+        IOException guardFailure = new IOException("request stream unavailable");
+        when(request.getInputStream()).thenThrow(guardFailure);
+        IOException original = new IOException("handler failed");
+        IOException caught = assertThrows(IOException.class,
+                () -> filter.doFilter(request, mock(HttpServletResponse.class), (req, res) -> { throw original; }));
+        assertSame(original, caught);
+        assertEquals(1, caught.getSuppressed().length);
+        assertSame(guardFailure, caught.getSuppressed()[0]);
+    }
+
+    private static HttpServletRequest request(String protocol, long length) throws Exception {
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getProtocol()).thenReturn(protocol);
+        when(request.getContentLengthLong()).thenReturn(length);
+        when(request.getInputStream()).thenReturn(mock(ServletInputStream.class));
+        return request;
+    }
+}
